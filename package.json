{
  "name": "ayla-tools-browse",
  "version": "0.1.2",
  "private": true,
  "description": "Bounded browse tool for Pi: search and read untrusted web documents through ayla-tools-web. Not an interactive UI browser; PDF text only, no screenshots.",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "extension",
    "browse",
    "web"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kekma-dot/ayla-tools-browse.git"
  },
  "bugs": {
    "url": "https://github.com/kekma-dot/ayla-tools-browse/issues"
  },
  "homepage": "https://github.com/kekma-dot/ayla-tools-browse#readme",
  "files": [
    "index.ts",
    "README.md",
    "README.ru.md",
    "assets",
    "LICENSE",
    "provenance.json"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "test": "node --test",
    "typecheck": "tsc",
    "verify:install": "node scripts/verify-git-install.mjs",
    "verify:pair": "node scripts/verify-pair.mjs"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  }
}
